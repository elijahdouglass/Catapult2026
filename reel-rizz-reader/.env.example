# Vite-exposed Clerk publishable key (from your Clerk dashboard:
# Developers → API Keys → Publishable key).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: Clerk "sync host" — the URL of your web app that uses Clerk.
# When set, the extension shares the same session as the web app so the user
# doesn't have to sign in twice. Example: http://localhost:5173
# VITE_CLERK_SYNC_HOST=http://localhost:5173

# Backend API base. Defaults to http://localhost:3001/api if unset.
# VITE_API_BASE=http://localhost:3001/api

# Extension key (from your Clerk dashboard's Chrome Extension app config) —
# needed in the manifest "key" field below for stable extension IDs. Without
# a stable ID, Clerk rejects extension sessions.
# CRX_KEY=
