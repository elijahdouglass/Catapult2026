generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  clerkId        String?  @unique
  email          String   @unique
  passwordHash   String?
  displayName    String
  igUserId       String?  @unique
  igUsername      String?
  igVerified     Boolean  @default(false)
  igVerifyCode   String?
  tags           String?  @db.Text
  tagVector      Bytes?   @db.MediumBlob
  screenshotPath String?
  onboarded      Boolean  @default(false)
  likeThreshold    Int      @default(3)
  worldIdVerified  Boolean  @default(false)
  worldIdNullifier String?  @unique
  createdAt        DateTime @default(now())

  likesGiven    Like[] @relation("LikerRelation")
  likesReceived Like[] @relation("LikeeRelation")
  reelViews     ReelView[]
  reelLikesGiven ReelLike[] @relation("ReelLikerRelation")
  reelLikesReceived ReelLike[] @relation("ReelOwnerRelation")
  seenGiven     SeenUser[] @relation("SeenViewer")
  seenReceived  SeenUser[] @relation("SeenTarget")
}

model SeenUser {
  id       Int      @id @default(autoincrement())
  viewerId Int
  seenId   Int
  seenAt   DateTime @default(now())

  viewer User @relation("SeenViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  seen   User @relation("SeenTarget", fields: [seenId], references: [id], onDelete: Cascade)

  @@unique([viewerId, seenId])
  @@index([viewerId])
  @@index([seenId])
}

model Like {
  id        Int      @id @default(autoincrement())
  likerId   Int
  likeeId   Int
  createdAt DateTime @default(now())

  liker User @relation("LikerRelation", fields: [likerId], references: [id], onDelete: Cascade)
  likee User @relation("LikeeRelation", fields: [likeeId], references: [id], onDelete: Cascade)

  @@unique([likerId, likeeId])
  @@index([likeeId])
}

model ReelView {
  id       Int      @id @default(autoincrement())
  userId   Int
  reelId   String
  videoUrl String?  @db.Text
  viewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([userId])
}

model ReelLike {
  id        Int      @id @default(autoincrement())
  likerId   Int
  ownerId   Int
  reelId    String
  createdAt DateTime @default(now())

  liker User @relation("ReelLikerRelation", fields: [likerId], references: [id], onDelete: Cascade)
  owner User @relation("ReelOwnerRelation", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([likerId, reelId])
  @@index([likerId, ownerId])
}
